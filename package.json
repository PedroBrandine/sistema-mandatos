{
  "name": "sistema-mandatos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "src/frontend"
  ],
  "scripts": {
    "lint": "eslint . && npm run lint --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:start": "supabase start",
    "db:types": "supabase gen types typescript --linked > src/backend/supabase/database.types.ts"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "csv-parser": "^3.2.1",
    "iconv-lite": "^0.7.3",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  }
}
