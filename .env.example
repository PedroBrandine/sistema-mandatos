# Copy to .env.local (gitignored) and fill in real values for your environment.
# Never commit .env.local. Never put service_role in any client-bundled variable
# (i.e. never prefix it with NEXT_PUBLIC_) -- AD-009.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side / test-fixture only. Used to create/clean up test users in
# supabase/tests/**. Never imported by src/frontend or any client bundle.
SUPABASE_SERVICE_ROLE_KEY=
